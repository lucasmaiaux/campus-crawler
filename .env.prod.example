# Variables de production - À COPIER vers .env.prod et compléter
# NE JAMAIS COMMITER .env.prod avec les vraies valeurs !

# Base de données
DB_NAME=campus_crawler
DB_USERNAME=campus_user
DB_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT_123!
DB_ROOT_PASSWORD=CHANGEZ_MOI_ROOT_PASSWORD_456!

# Docker Hub (pour push des images)
DOCKER_USERNAME=lucasmaiaux
VERSION=latest

# Domaine
DOMAIN=lucas-maiaux.fr

# Chemins (sur le VPS)
FRONTEND_PATH=./frontend

# CORS
CORS_ALLOWED_ORIGINS=https://lucas-maiaux.fr,https://www.lucas-maiaux.fr

# SSL (optionnel - si vous utilisez Let's Encrypt)
# SSL_CERTIFICATE_PATH=/etc/letsencrypt/live/votredomaine.com/fullchain.pem
# SSL_CERTIFICATE_KEY_PATH=/etc/letsencrypt/live/votredomaine.com/privkey.pem
